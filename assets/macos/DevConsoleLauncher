#!/bin/bash
set -euo pipefail

contents="$(cd "$(dirname "$0")/.." && pwd)"
package_root="$(cd "$contents/../.." && pwd)"
pet_app="$package_root/Pet2.app"
console="$contents/Resources/DevConsole"

if [[ ! -d "$pet_app" ]]; then
  echo "Pet2.app must be installed beside Pet2 Dev Console.app" >&2
  exit 1
fi

# Connect to Pet owns the temporary lease and optional launch. Opening the
# console never interrupts the companion or forces permanent telemetry.
exec "$console" --live-pet
